graph TB
    %% Top (UI) -> Domain (Coordinators) -> Domain (Managers/UseCases) -> Domain (Workers/Processors) -> Data & Service Layer (bottom)

    subgraph "UI Layer (Top)"
        direction TB
        A[AeroGlideViewModel]
    end

    subgraph "Domain Layer - Coordinators"
        direction TB
        B(FlightSessionCoordinatorUseCase)
    end

    subgraph "Domain Layer - Managers (UseCases)"
        direction TB
        C[RecordActivityUseCase]
        D[CalibrationUseCase]
        E[AutoStartUseCase]
        M[AppStateManager]
    end

    subgraph "Domain Layer - Workers (Processors)"
        direction TB
        C_P[RecordingProcessor]
        D_P[CalibrationProcessor]
        E_P[AutoStartProcessor]
    end
    
    subgraph "Data & Service Layer (Bottom)"
        direction TB
        F[AppRepository]
        G[SensorRepository]
        H[DataRepository]
        I[LocationService]
    end

    %% Wiring: top to bottom
    A --> B
    B --> C
    B --> D
    B --> E

    %% Managers delegate to processors and to services
    C --> C_P
    D --> D_P
    E --> E_P

    C --> M
    D --> M
    E --> M

    C_P --> G
    C_P --> H
    D_P --> F
    D_P --> G
    E_P --> G

    %% Processors interact with Services
    C --> I
    D --> I
    E --> I

    %% AppStateManager interacts with repositories
    M --> F
    M --> H

    %% Sensor repository provides data to processors/services
    G --> I

    %% Styling removed: class statements referenced subgraph titles which are not valid node ids in Mermaid.
    %% If you want node-level styling, use `class A,B,C layerTitle` with node ids.
